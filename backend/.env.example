# ---- OpenAI ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- Database engine ----
# Which backend to run queries against: sqlite | mssql | mock
#   sqlite -> local file DB, no install needed (POC default, recommended)
#   mssql  -> Microsoft SQL Server (fill the MSSQL_* values below)
#   mock   -> canned sample rows, no real database
DB_ENGINE=sqlite

# ---- SQLite (used when DB_ENGINE=sqlite) ----
# Path to the local database file. Auto-created + seeded on first use.
SQLITE_PATH=poc.db

# ---- Microsoft SQL Server (used when DB_ENGINE=mssql) ----
# Use a READ-ONLY database user here (see README "Connecting to Microsoft SQL").
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=YourDatabase
MSSQL_USER=readonly_user
MSSQL_PASSWORD=your_password
# ODBC driver name as installed on the machine
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Set to "yes" for self-signed/dev certs, "no" for trusted production certs
MSSQL_TRUST_CERT=yes

# Max rows returned to the chat
MAX_ROWS=200
