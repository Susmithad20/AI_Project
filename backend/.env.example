# ---- OpenAI ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- Microsoft SQL Server ----
# Use a READ-ONLY database user here (see README "Connecting to Microsoft SQL").
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=YourDatabase
MSSQL_USER=readonly_user
MSSQL_PASSWORD=your_password
# ODBC driver name as installed on the machine
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
# Set to "yes" for self-signed/dev certs, "no" for trusted production certs
MSSQL_TRUST_CERT=yes

# Set to "true" to skip the real DB and return mock rows (handy before MSSQL is wired up)
USE_MOCK_DB=true

# Max rows returned to the chat
MAX_ROWS=200
